{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://xzhao.net/schemas/xz_visit_stats/bridge/state.schema.json",
  "title": "GPT-Codex Bridge State",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "status",
    "stage",
    "request_id",
    "thread_id",
    "head_sha",
    "repair_round",
    "infra_retry_round",
    "last_verified_gate",
    "next_action",
    "updated_at"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "status": {
      "enum": [
        "IDLE",
        "CONTEXT_SYNC",
        "RESUME_GATE",
        "REQUIREMENT_GATE",
        "REUSE_GATE",
        "CHANGE_IMPACT_GATE",
        "BASELINE_INHERITANCE_GATE",
        "EXPECTED_DIFF_GATE",
        "LANE_ROUTE",
        "TASK_DISPATCH",
        "CODEX_RUNNING",
        "CODEX_TURN_COMPLETED",
        "RESULT_COLLECT",
        "GPT_REVIEW",
        "GPT_DECISION",
        "REPAIR",
        "REVERIFY",
        "UNIT_TEST",
        "LOCAL_RUNTIME",
        "SQL_EXPLAIN",
        "GITHUB_CI",
        "CANDIDATE_BUILD",
        "FINAL_RUNTIME",
        "RELEASE_GATE",
        "ROLLBACK_GATE",
        "VERSION_CONSISTENCY_GATE",
        "RELEASE",
        "NOTION_WRITEBACK",
        "PROJECT_STATE_WRITEBACK",
        "PAUSED_QUOTA",
        "PLUGIN_RELEASED",
        "BLOCKED",
        "FAILED"
      ]
    },
    "stage": {"type": "string", "minLength": 1},
    "request_id": {"anyOf": [{"type": "string", "minLength": 1}, {"type": "null"}]},
    "thread_id": {"anyOf": [{"type": "string", "minLength": 1}, {"type": "null"}]},
    "controller_response_id": {"anyOf": [{"type": "string", "minLength": 1}, {"type": "null"}]},
    "head_sha": {"anyOf": [{"type": "string", "pattern": "^[0-9a-f]{40}$"}, {"type": "null"}]},
    "candidate_sha": {"anyOf": [{"type": "string", "pattern": "^[0-9a-f]{40}$"}, {"type": "null"}]},
    "repair_round": {"type": "integer", "minimum": 0, "maximum": 100},
    "infra_retry_round": {"type": "integer", "minimum": 0, "maximum": 1000},
    "last_verified_gate": {"anyOf": [{"type": "string", "minLength": 1}, {"type": "null"}]},
    "next_action": {"type": "string", "minLength": 1},
    "blocked_reason": {"anyOf": [{"type": "string", "minLength": 1}, {"type": "null"}]},
    "quota_provider": {"anyOf": [{"type": "string", "enum": ["openai_responses", "codex", "unknown"]}, {"type": "null"}]},
    "quota_reason": {"anyOf": [{"type": "string", "minLength": 1}, {"type": "null"}]},
    "resume_after": {"anyOf": [{"type": "string", "format": "date-time"}, {"type": "null"}]},
    "quota_checkpoint_path": {"anyOf": [{"type": "string", "minLength": 1}, {"type": "null"}]},
    "updated_at": {"anyOf": [{"type": "string", "format": "date-time"}, {"type": "null"}]}
  }
}
