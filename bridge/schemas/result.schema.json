{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://xzhao.net/schemas/xz_visit_stats/bridge/result.schema.json",
  "title": "GPT-Codex Bridge Result",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "request_id",
    "stage",
    "result",
    "branch",
    "head_sha",
    "files_changed",
    "tests",
    "runtime_checks",
    "sql_explain",
    "ci",
    "failures",
    "root_cause",
    "release_gate",
    "next_action"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "request_id": {"type": "string", "minLength": 1},
    "stage": {"type": "string", "minLength": 1},
    "result": {"enum": ["PASS", "REPAIRABLE", "RETRYABLE_INFRA", "BLOCKED", "FAILED"]},
    "branch": {"type": "string", "minLength": 1},
    "head_sha": {"anyOf": [{"type": "string", "pattern": "^[0-9a-f]{40}$"}, {"type": "null"}]},
    "files_changed": {"type": "array", "items": {"type": "string"}},
    "tests": {"type": "array", "items": {"type": "object"}},
    "runtime_checks": {"type": "array", "items": {"type": "object"}},
    "sql_explain": {"type": "array", "items": {"type": "object"}},
    "ci": {"type": "object"},
    "failures": {"type": "array", "items": {"type": "object"}},
    "root_cause": {"anyOf": [{"type": "string"}, {"type": "null"}]},
    "release_gate": {"enum": ["NOT_READY", "PASS", "BLOCKED"]},
    "rollback_gate": {"enum": ["NOT_EVALUATED", "PASS", "PASS_FORWARD_ONLY", "NOT_REQUIRED", "BLOCKED"]},
    "executor_transport": {"enum": ["codex_app_server", "codex_exec_fallback", "not_started"]},
    "evidence_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "next_action": {"type": "string", "minLength": 1}
  }
}
