{
  "version": 1,
  "description": "xz_visit_stats 正式用户界面术语门禁。仅扫描后台入口、导航和写入 DOM 的前端文案。",
  "include": ["main.php", "inc/admin.php", "assets/admin.js", "assets/filter.js", "assets/v3_admin.js", "assets/v3_dashboard.js", "assets/v3_realtime.js", "assets/rum.js"],
  "exclude": ["vendor/", "node_modules/", "tests/", "docs/", "inc/upgrade/", "inc/install.php", "tools/", ".git/"],
  "blocking_patterns": ["字段\\s*\\d+", "\\bDurationMs\\b", "\\bPathKey\\b", "\\bKeyset\\b", "\\bOFFSET\\b", "\\bcursor\\b", "\\bmigration\\b", "\\bbackfill\\b", "\\bReferer\\b", "\\bBrowser\\b", "\\bDevice\\b", "\\bCampaign\\b", "\\bAI\\s+crawler\\b", "规范化\\s*Path", "下钻", "\\bP(?:50|75|95)\\b"],
  "contextual_terms": ["RUM", "LCP", "INP", "CLS", "TTFB", "FCP", "Beacon", "CIDR", "Header", "Path"],
  "internal_enum_patterns": ["\\bdirect\\b", "\\bsearch\\b", "\\bsocial\\b", "\\bexternal\\b", "\\binternal\\b", "\\bdesktop\\b", "\\bmobile\\b", "\\btablet\\b"],
  "allow_marker": "ui-term:allow",
  "rendered_replacements": {
    "DurationMs": "服务器响应耗时", "PathKey": "页面数据状态", "Referer": "来源地址", "Browser": "浏览器", "Device": "设备类型", "Campaign": "推广活动", "AI crawler": "AI 爬虫", "规范化 Path": "页面访问", "下钻": "查看访问记录", "Path": "页面路径", "P50": "中位数", "P75": "较慢访问", "P95": "最慢访问", "RUM": "页面加载体验", "Beacon": "页面加载体验采集", "CIDR": "地址范围", "Header": "转发字段", "complete": "正常"
  }
}
